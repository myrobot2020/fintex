# Dockerfile for Multi-Source Tick Viewer
FROM rocker/shiny:4.3.0

# System deps
RUN apt-get update && apt-get install -y \
    libcurl4-openssl-dev \
    libssl-dev \
    libxml2-dev \
    && rm -rf /var/lib/apt/lists/*

# R packages
RUN R -e "install.packages(c('shiny', 'ggplot2', 'dplyr', 'lubridate', 'plotly', 'readr', 'tidyr'), repos='https://cloud.r-project.org/')"

WORKDIR /app
COPY tick_viewer.R /app/app.R
# Note: For cloud, you would COPY or MOUNT the data source here,
# or update the R code to pull from BigQuery.

EXPOSE 8080

CMD ["R", "-e", "shiny::runApp('/app', host='0.0.0.0', port=8080)"]
